# Your patch layer for this dsh profile, applied after every bundle layer:
# a top-level YAML array of loader patch entries (id-targeted config
# overrides, disables, and insert lists; `!!js` expressions allowed).
- id: ui-chat
  name: "@deepseek-ai/dsh-client-ui-chat"
  config:
    transcriptView: standard
    performanceUsage: detailed
- id: ui-settings
  name: "@deepseek-ai/dsh-client-ui-settings"
  config:
    enabled: true
- id: ui-settings-account
  name: "@deepseek-ai/dsh-client-ui-settings-account"
  config:
    version: 1
    step: done
    usage: detailed
    developerTools: true
    purpose: null
    process: standard
    completion: api-key
- id: ui-theme
  name: "@deepseek-ai/dsh-client-ui-theme"
  config:
    preference: dark
    fontSize: 16
# GPT models served by the local openai-api-server-via-codex bridge.
# The bridge is a separate process and must be running, with the local proxy
# up and the ChatGPT-mode credentials in %USERPROFILE%\.codex-chatgpt\auth.json:
#   D:\AA12583\dsh\组件\openai-api-server-via-codex\start-server.cmd
# It accepts any non-empty key, hence the placeholder Authorization header.
- id: llm-pi-ai
  name: "@deepseek-ai/dsh-llm-pi-ai"
  config:
    providers:
      gpt-local:
        displayName: GPT (Codex bridge)
        api: openai-completions
        baseURL: http://127.0.0.1:18080/v1
        compat:
          supportsReasoningEffort: true
          thinkingFormat: openai
        headers:
          Authorization: "Bearer dummy-not-a-real-openai-api-key"
        models:
          - id: gpt-5.6-luna
            name: GPT-5.6 Luna
            contextWindow: 200000
            maxTokens: 32768
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: gpt-6-luna
            name: GPT-6 Luna
            contextWindow: 200000
            maxTokens: 32768
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
          - id: gpt-6.1-sol
            name: GPT-6.1 Sol
            contextWindow: 200000
            maxTokens: 32768
            reasoningEfforts:
              low: low
              medium: medium
              high: high
              xhigh: xhigh
- id: agent-default-model
  name: "@deepseek-ai/dsh-agent-default-model"
  config:
    provider: gpt-local
    model: gpt-6.1-sol
    reasoningEffort: high

- insert:
    - id: gpt-quota
      name: 'file:///D:/AA12583/dsh/%E7%BB%84%E4%BB%B6/gpt-quota-plugin/index.mjs'
      config:
        revision: 5

# dsh-desktop-pet is selected in package.json -> dsh.profile.bundles.
# That bundle's own cordis.patch.yml inserts the `desktop-pet` row; override
# its config (petScale / petId / hideWhenIdle / ...) here if you want.

